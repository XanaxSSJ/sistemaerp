# Copiar a `.env.production` (no se versiona).
# Se embebe en el instalador al correr `pnpm dist`.
#
# Prioridad en runtime:
#   1) MEBSY_API_URL en .env (dev / override)
#   2) MAIN_VITE_MEBSY_API_URL embebida (app empaquetada)
#   3) http://127.0.0.1:3001

MAIN_VITE_MEBSY_API_URL=https://TU-APP.koyeb.app
